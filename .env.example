# Copiar este archivo como .env antes de iniciar la instalación.
# Usar valores largos y únicos; no subir .env al repositorio.
JWT_SECRET=reemplazar-por-un-secreto-largo-y-unico
ADMIN_USERNAME=admin
ADMIN_PASSWORD=reemplazar-por-una-contrasena-segura
DB_PASSWORD=reemplazar-por-una-contrasena-de-base-de-datos
MYSQL_ROOT_PASSWORD=reemplazar-por-otra-contrasena-larga-y-unica
TMDB_API_KEY=pegar-tu-clave-de-themoviedb-aqui
STREAMAPP_PORT=8081
# Ruta de tus archivos en la computadora anfitriona. Por defecto: ./media
# MEDIA_PATH=D:/Media
