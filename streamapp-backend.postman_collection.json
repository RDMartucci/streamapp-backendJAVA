            }
          }
        },
        {
          "name": "Explorer con token USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const arr = pm.response.json();",
                  "    const playable = Array.isArray(arr) ? arr.find(n => n.playable && n.streamUrl) : null;",
                  "    if (playable) {",
                  "        pm.collectionVariables.set('streamTicket', playable.streamUrl.replace(/^\\/api\\/stream\\//, ''));",
                  "        pm.collectionVariables.set('currentMedia', playable.name);",
                  "        console.log('streamTicket capturado:', playable.streamUrl);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/explorer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "explorer"]
            }
          },
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
              }
            ]
          }
        },
