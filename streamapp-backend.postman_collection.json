    {
      "name": "06 - Streaming",
      "item": [
        {
          "name": "Stream completo (sin Range)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stream/{{streamTicket}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stream", "{{streamTicket}}"]
            },
            "description": "Antes de correrlo, ejecutar 'Explorar media/musica' para capturar la variable streamTicket. En la pestaña Headers de la respuesta debe verse Accept-Ranges: bytes."
          }
        },
        {
          "name": "Stream con Range bytes=0-99",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Range",
                "value": "bytes=0-99"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stream/{{streamTicket}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stream", "{{streamTicket}}"]
            },
            "description": "Esperado: 206, Content-Range: bytes 0-99/8192."
          }
        },
        {
          "name": "Stream con Range bytes=4000-",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Range",
                "value": "bytes=4000-"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stream/{{streamTicket}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stream", "{{streamTicket}}"]
            }
          }
        },
        {
          "name": "Stream con Range suffix bytes=-500",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Range",
                "value": "bytes=-500"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stream/{{streamTicket}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stream", "{{streamTicket}}"]
            },
            "description": "Esperado: Content-Range: bytes 7692-8191/8192."
          }
        },
        {
          "name": "Stream con ticket manipulado (esperado 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stream/{{streamTicket}}XYZ",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stream", "{{streamTicket}}XYZ"]
            },
            "description": "Concatenar caracteres al final del ticket para invalidar la firma."
          }
        },
        {
          "name": "Stream fuera de rango bytes=99999-",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Range",
                "value": "bytes=99999-"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stream/{{streamTicket}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stream", "{{streamTicket}}"]
            },
            "description": "Esperado: 200 con el archivo completo (rango invalido se ignora, RFC 7233)."
          }
        }
      ]
    },
