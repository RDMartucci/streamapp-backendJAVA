{
  "info": {
    "_postman_id": "9f4b2c1e-8a3d-4d5e-9b6f-1c2d3e4f5a6b",
    "name": "StreamApp Backend",
    "description": "Pruebas del backend streamapp. El login guarda el token automáticamente y el explorador captura el ticket de streaming (variable streamTicket) para los tests de streaming. Cambiar la variable baseUrl si el servidor corre en otra puerta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Autenticacion",
      "item": [
        {
          "name": "Register (nuevo usuario)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "    pm.collectionVariables.set('username', pm.response.json().username);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"prueba1\",\n  \"password\": \"secreto123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
